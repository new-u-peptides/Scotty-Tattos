# Booking flow — see README.md "Booking flow" section for the full picture.
#
# Resend (https://resend.com) sends the automated process email to clients
# and forwards completed booking applications to the studio inbox.
RESEND_API_KEY=

# "From" address for outgoing mail. Must be on a domain verified with Resend.
RESEND_FROM_EMAIL="Massa Tattoo Social Club <booking@scottymassa.com>"

# Inbox that receives new enquiries and completed booking applications.
# Defaults to studio@scottymassa.com if unset.
BOOKING_NOTIFY_EMAIL=studio@scottymassa.com
